      "occurrenceStart": "value",
      "includeContext": [
        "qualifier"
      ],
      "fields": {
        "value": {
          "select": ":value",
          "type": "string",
          "many": false
        },
        "language": {
          "select": ":language",
          "type": "string",
          "many": false
        }
      }
    },
    "keywords": {
      "forEach": [
        "dc.subject.armarc",
        "dc.subject.ddc",
        "dc.subject.decs",
        "dc.subject.keyword",
        "dc.subject.keywords",
        "dc.subject.lcsh",
        "dc.subject.lemb",
        "dc.subject.mesh",
        "dc.subject.none",
        "dc.subject.other",
        "dc.subject.proposal",
        "dc.subject.spines",
        "dc.subject.unesco",
        "dcterms.subject.Lemb",
        "dcterms.subject.none"
      ],
      "occurrenceStart": "value",
      "includeContext": [
        "qualifier"
      ],
      "fields": {
        "value": {
          "select": ":value",
          "type": "string",
          "many": false
        },
        "language": {
          "select": ":language",
          "type": "string",
          "many": false
        }
      }
    }
  }
}
