{
  "specVersion": 1,
  "name": "classification-embeddings",
  "version": "2.0",
  "inputSchema": "xoai",
  "fields": {
    "titles": {
      "forEach": "dc.title.*",
      "occurrenceStart": "value",
      "includeContext": [
        "qualifier"
      ],
      "fields": {
        "value": {
          "select": ":value",
          "type": "string",
          "many": false
        },
        "language": {
          "select": ":language",
          "type": "string",
          "many": false
        }
      }
    },
    "descriptions": {
      "forEach": "dc.description.*",
      "occurrenceStart": "value",
      "includeContext": [
        "qualifier"
      ],
      "fields": {
        "value": {
          "select": ":value",
          "type": "string",
          "many": false
        },
        "language": {
          "select": ":language",
          "type": "string",
          "many": false
        }
      }
    },
    "keywords": {
      "forEach": "dc.subject.*",
      "occurrenceStart": "value",
      "includeContext": [
        "qualifier"
      ],
      "fields": {
        "value": {
          "select": ":value",
          "type": "string",
          "many": false
        },
        "language": {
          "select": ":language",
          "type": "string",
          "many": false
        }
      }
    }
  }
}
